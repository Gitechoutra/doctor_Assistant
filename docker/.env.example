# MediAssist AI -- container configuration.
#
#   cd docker
#   cp .env.example .env          (PowerShell: Copy-Item .env.example .env)
#
# Then fill in the four values marked REQUIRED and run
#
#   docker compose -f docker/compose.yaml up -d --build
#
# docker/.env is git-ignored (docker/.gitignore) and is never copied into an
# image -- compose reads it on the host and injects the values as environment
# variables. No secret belongs in any other file in this folder.
#
# The backend reads real environment variables before anything else
# (backend/config/config.py), so these values win outright. backend/.env and
# backend/config/dev.ini are excluded from the image entirely: the container
# never sees your local credentials.


# =============================================================================
# REQUIRED -- compose refuses to start without these four
# =============================================================================

# Flask's session signing key and the JWT signing key. Two different random
# strings; changing JWT_SECRET_KEY signs everyone out.
#
# Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=

# MySQL. DB_PASSWORD is the application account's password, MYSQL_ROOT_PASSWORD
# is root's -- the app never uses root.
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=


# =============================================================================
# Database -- the defaults are the ones the project already uses
# =============================================================================

# Leave DB_NAME as `doctor`. database/schema.sql -- the project's own file,
# which this setup imports rather than edits -- names that database in its
# CREATE DATABASE and USE statements. A different name here would create an
# empty database beside the populated one.
DB_NAME=doctor

# The account the app connects as. Not root, and created by the MySQL image on
# first start with rights on DB_NAME only.
DB_USER=mediassist


# =============================================================================
# Ports and public addresses
# =============================================================================
# The three must agree. PUBLIC_API_BASE_URL is compiled into the frontend
# bundle (Vite inlines it), and PUBLIC_FRONTEND_URL is what the backend's CORS
# allow-list and its emailed links name -- so a port changed in one place and
# not the others shows up as every API call refused by CORS.

# Host port for the API. 5000 is what backend/app.py binds and what
# frontend/.env.example documents.
#
# Note for this machine: another application already binds 5000 on Windows.
# If `docker compose up` reports the port is in use, set both of these
# together, e.g. BACKEND_HOST_PORT=5050 and
# PUBLIC_API_BASE_URL=http://localhost:5050/api
BACKEND_HOST_PORT=5000

# Host port for the app itself. 5173 is the port it is developed on.
FRONTEND_HOST_PORT=5173

PUBLIC_API_BASE_URL=http://localhost:5000/api
PUBLIC_FRONTEND_URL=http://localhost:5173

# Reaching the app from another machine -- a phone, or a staff member
# following an emailed link -- means naming this machine's LAN address in both
# of the URLs above rather than localhost. `ipconfig` shows it. The ports stay
# the same.


# =============================================================================
# Optional -- every one of these has a working default
# =============================================================================

# Gemini drafts the consultation summary, the assistive diagnosis and the
# prescription suggestion. Unset, those features report themselves
# unavailable; the rest of the application is unaffected.
GEMINI_API_KEY=

# Outbound mail -- staff credentials and password-reset links. With SMTP_HOST
# blank, backend/portal/helpers/email.py logs each message instead of sending
# it, which is a perfectly usable local setup.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
MAIL_FROM=
MAIL_FROM_NAME=
MAIL_ENABLED=true

# What goes on the letterhead of prescriptions, reports and emails.
PRACTICE_NAME=MediAssist AI
PRACTICE_ADDRESS=
PRACTICE_PHONE=
PRACTICE_EMAIL=
PRACTICE_WEBSITE=

# Domains an email address may be at, anywhere one is typed. `*` turns the
# restriction off.
ALLOWED_EMAIL_DOMAINS=gmail.com,outlook.com

# Token lifetimes.
JWT_ACCESS_MINUTES=480
JWT_REFRESH_DAYS=30

# The doctor's login. LEAVE THESE BLANK to keep the login exactly as it is
# today -- blank means the account is seeded from
# backend/portal/seeders/seed_doctor.py, unchanged. Set them only to give the
# container a different doctor login without editing that file.
#
# There is no PA seed by design: the doctor creates assistant accounts from
# inside the application.
SEED_DOCTOR_NAME=
SEED_DOCTOR_EMAIL=
SEED_DOCTOR_PASSWORD=

# false stops the seeder rewriting an existing doctor account on restart --
# set it once the practice has changed the password from inside the app.
SEED_ACCOUNT_SYNC=true


# =============================================================================
# Build
# =============================================================================
# torch and openai-whisper are listed in backend/requirements.txt but imported
# nowhere in backend/, and are not installed in the project's own virtualenv
# either. The image leaves them out, which saves roughly a gigabyte. Set this
# to true to install them (CPU wheels, as requirements.txt documents).
INSTALL_TRANSCRIBER_EXTRAS=false
