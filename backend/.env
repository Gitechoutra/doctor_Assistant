Backend=DEV
 
#
# DATABASE
#
# The hospital portal's own database. Deliberately NOT the DSN from the
# StockVerse template -- pointing this app at that schema would take every
# patient, consultation and prescription record out from under it.
#
DATABASE_URL=mysql+pymysql://root:Chi198@127.0.0.1:3306/yasodha_ai?charset=utf8mb4
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=yasodha_ai
DB_USER=root
DB_PASSWORD=Chi198
 
#
# APP SECRET
#
APP_SECRET_KEY=6L7XnCrphNFLeBzK92hAI8JZPmrSZbq4aBnZ4rcFHFRugoJCwoND_AHnjdGgOhkW
 
#
# JWT CONFIGURATION
#
JWT_SECRET_KEY=r0RIjvlUuatQSqlt5wwU8y1821u7fbF4iC4nCQ-V9b5CwlD-kfmtbyy8pdcJaJy_
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30
 
#
# MAIL CONFIGURATION
#
# Gmail needs an App Password, not the account password. Spaces removed:
# Google displays it in groups of four, but SMTP AUTH wants the sixteen
# characters with nothing between them.
#
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=tg568685@gmail.com
MAIL_PASSWORD=sxftqlhpgmupfunv
# Must be the same mailbox as MAIL_USERNAME. Gmail rewrites a From: that
# names any other address to the authenticated account anyway, so a mismatch
# does not send "as" anyone — it just makes the header and the envelope
# disagree, which is a point against you with receiving spam filters.
MAIL_DEFAULT_SENDER=Yasodha Hospitals <tg568685@gmail.com>
 
# Read by the ini's %(SMTP_USER)s / %(SMTP_PASSWORD)s placeholders. Same two
# values as MAIL_USERNAME / MAIL_PASSWORD above; both spellings are accepted,
# so change them together.
SMTP_USER=tg568685@gmail.com
SMTP_PASSWORD=sxftqlhpgmupfunv
 
#
# FRONTEND
#
# The host every emailed link is built from. NOT localhost: a staff member
# reads that email on their own machine, where localhost is their machine.
# This value overrides frontend_base_url in dev.ini -- a real environment
# variable always wins -- so it is the one that actually decides.
FRONTEND_BASE_URL=http://localhost:5173/
 
#
# PASSWORD RESET TOKEN
#
# No RESET_TOKEN_SECRET or RESET_TOKEN_SALT: this portal does not sign its
# reset tokens. Each is 32 random bytes and only its SHA-256 is stored, so
# there is no secret whose leak would let anybody mint a link.
# RESET_TOKEN_EXPIRES is in seconds, matching the house template.
#
RESET_TOKEN_EXPIRES=3600
INVITE_TOKEN_HOURS=72
 
#
# AI (Gemini)
#
GEMINI_API_KEY=AQ.Ab8RN6I7rUdXH7cu81kQRSTttoq2oprQPPh9VXuOT79aOQbJPA
 